# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URLs
MAIN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/main_app_db
AUTH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auth_service_db

# Inter-service gRPC URL
AUTH_GRPC_URL=localhost:50051
AUTH_GRPC_PORT=50051

# Redis Configuration (Optional / Upcoming)
REDIS_HOST=localhost
REDIS_PORT=6379
